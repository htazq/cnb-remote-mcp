# CNB upstream / CNB 上游。Create a PAT in CNB account settings.
# Grant only the repositories and operations you need / 仅授权所需仓库及操作。
CNB_TOKEN=
CNB_API_BASE_URL=https://api.cnb.cool
CNB_WEB_BASE_URL=https://cnb.cool

# Client access keys / 客户端访问密钥。Generate: openssl rand -hex 32
# Separate from CNB_TOKEN. Comma-separated, one per client.
# 与 CNB_TOKEN 分开；多个用逗号分隔。OAuth owner consent needs 32+ characters.
MCP_ACCESS_TOKENS=

MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000
# HTTPS origin without a path / 不含路径的 HTTPS 地址。Blank is allowed for local Bearer use.
MCP_PUBLIC_BASE_URL=
MCP_WRITE_MODE=read-only

# Optional ChatGPT OAuth / 可选 ChatGPT OAuth。Leave all three blank to disable.
# 启用需填写以上 HTTPS 地址、CNB_TOKEN 和至少一个 32 位以上的访问密钥。
MCP_OAUTH_CLIENT_ID=
# Generate a DIFFERENT key / 生成另一个独立密钥：openssl rand -hex 32
MCP_OAUTH_CLIENT_SECRET=
# Exact HTTPS callback(s) from ChatGPT management, comma-separated.
# 从 ChatGPT 管理页复制精确回调地址；多个用逗号分隔，不能使用通配符。
MCP_OAUTH_REDIRECT_URIS=

# Used only by compose.cloudflare.yaml / 仅供 Cloudflare Compose 扩展使用。
# Copy the connector token from Cloudflare. This is NOT a Cloudflare API key.
# 从 Cloudflare 隧道安装命令中取出的连接器 token，不是 API key。
TUNNEL_TOKEN=

MCP_GIT_TIMEOUT_SECONDS=180
MCP_GIT_MAX_WORKSPACES=20
MCP_DATA_DIR=/app/data
MCP_LOG_LEVEL=info
