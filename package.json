{
  "name": "cnb-remote-mcp",
  "version": "0.3.0",
  "description": "Unofficial, self-hosted Remote MCP Server for CNB.cool: operate repos, issues, pull requests, CI builds and NPC agents from any MCP client.",
  "type": "module",
  "license": "MIT",
  "author": "cnb-remote-mcp contributors",
  "homepage": "https://cnb.cool/htazq/cnb-remote-mcp",
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/htazq/cnb-remote-mcp.git"
  },
  "keywords": [
    "cnb",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "remote-mcp",
    "streamable-http",
    "devops"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "bin": {
    "cnb-remote-mcp": "dist/index.js",
    "cnb-remote-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:http": "node --env-file-if-exists=.env dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint --fix src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.1.12"
  }
}
